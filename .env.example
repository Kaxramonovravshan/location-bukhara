# Cloudflare R2 S3-compatible upload credentials. Never expose these via Vite.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=location-bukhara
R2_PUBLIC_URL=https://images.buxorofilm.com

# Optional upload tuning
R2_CONCURRENCY=4
R2_RETRIES=3
R2_TIMEOUT_MS=60000

# Public browser-facing media base URL; never put R2 credentials behind VITE_.
VITE_R2_PUBLIC_URL=https://images.buxorofilm.com
